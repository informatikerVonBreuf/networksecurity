# Optional: local CSV training works without MongoDB or AWS.
MONGO_DB_URL=
MONGO_DATABASE=networksecurity
MONGO_COLLECTION=NetworkData
# Set an HTTP tracking server URI to enable MLflow logging.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# Set a bucket name to enable explicit S3 artifact upload.
TRAINING_BUCKET_NAME=
AWS_DEFAULT_REGION=eu-west-3
